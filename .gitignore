/target

# Commercial cart images, BIOS-ish dumps, save states, classifier output — ALL of
# it stays out of git. Blanket-ignore the whole dumps/ tree: no copyrighted ROM
# can ever be committed, regardless of subfolder. (The NES has no boot ROM;
# FDS BIOS + bulk ROM corpora live here too.) Bring your own dumps.
/dumps/

# Vendored TomHarte 6502 single-step vector clone (the CPU conformance corpus).
/tests/vendor/

# Headless render / audio dumps from the dev harnesses.
/out/

# Local convenience junction -> TrophyHubAndroid app jniLibs (deploy target)
android-jnilibs/

# Symbol listing for the demo cart: derived from the committed source by
# `nes-asm -s`, so it is regenerable and would only add churn.
/roms/famirust-demo/*.sym
